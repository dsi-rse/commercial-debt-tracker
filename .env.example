# CDT's local artifact root: every dataset is written directly under it, so
# give it a folder of its own. The website repo shares it, reading final tables
# from DATA_DIR/database/cdt.
DATA_DIR=~/Library/CloudStorage/Box-Box/commercial-debt-tracker/processor

# LLM credentials.
# OPENAI_API_KEY powers the `batch` extractor backend, the default for both
# `cdt extract` and `cdt run` (and the only one `cdt run poll` uses).
# OPENROUTER_API_KEY powers the `live` backend (`--backend live` /
# `--extractor-backend live`) and the 6-K stage-2 triage in `cdt classify`.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Pulumi stack-secret passphrase, used only by the `make infra-*` targets.
# Stored in the Core Facility Bitwarden. Without it Pulumi prompts or fails.
PULUMI_CONFIG_PASSPHRASE=
