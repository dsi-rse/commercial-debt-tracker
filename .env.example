# Shared local data root used by both CDT repos.
DATA_DIR=~/Library/CloudStorage/Box-Box

# LLM extractor credentials.
# OPENROUTER_API_KEY powers the synchronous `live` backend (local dev, `cdt extract`).
# OPENAI_API_KEY powers the `batch` backend used by `cdt-orchestrator poll`.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Declared contact for EDGAR requests, required by SEC's fair-access policy:
# "<organization> <contact email>". Only the direct-EDGAR 6-K fallback uses it.
# Without it sec.gov returns an "Undeclared Automated Tool" page, not the file.
SEC_USER_AGENT=

# Pulumi stack-secret passphrase, used only by the `make infra-*` targets.
# Stored in the Core Facility Bitwarden. Without it Pulumi prompts or fails.
PULUMI_CONFIG_PASSPHRASE=
