# Loaded automatically by direnv on entering the project. Run `direnv allow` once.
# - `dotenv` loads local secrets/config from .env (OPENAI_API_KEY, OPENROUTER_API_KEY,
#   PULUMI_CONFIG_PASSPHRASE, DATA_DIR, ...).
# - the exports point AWS/Pulumi at this project's account; override by setting the
#   variable in your shell before cd-ing in.
dotenv

export AWS_PROFILE=${AWS_PROFILE:-idi-analysis}
export AWS_REGION=${AWS_REGION:-us-east-2}
export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-$AWS_REGION}
export AWS_SDK_LOAD_CONFIG=1
